# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001

# ── Database (MariaDB) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wisatapass
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-32-random-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-use-32-random-chars
JWT_REFRESH_EXPIRES_IN=30d

# ── QR Code Security ──────────────────────────────────────────────────────────
QR_SECRET=change-me-qr-hmac-secret-use-32-random-chars
QR_ENCRYPTION_KEY=change-me-aes-key-must-be-32-chars!!
QR_EXPIRY_HOURS=24

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=WisataPass
APP_URL=http://localhost:3001
CLIENT_URL=http://localhost:3001

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=200

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Midtrans Payment Gateway ──────────────────────────────────────────────────
# Get keys from https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
